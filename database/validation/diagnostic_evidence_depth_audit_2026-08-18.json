{"version":"0.4.0","audit_date":"2026-08-18","purpose":"Track evidence strength behind high-use misconception records separately from diagnostic route coverage.","status_definitions":{"direct_empirical":"A checked original study directly supports the relevant reasoning pattern within stated sample limits.","direct_empirical_language_mediated":"A checked study directly supports the error pattern but shows that language structure materially affects whether/how it appears.","direct_empirical_broad_construct_or_mechanism":"An original study supports the broader construct or mechanism, but not every detail of the MathBridge wording or target age range.","evidence_synthesis":"An evidence-reviewed practice guide or research synthesis supports the instructional interpretation.","guidance_supported":"Official teaching guidance supports the instructional risk or response, but direct misconception-specific evidence has not been checked.","curriculum_inferred":"The pattern is mathematically plausible but direct evidence for the exact claim is not verified.","research_required":"The exact wording is stronger than the evidence currently verified."},"reviewed_high_use_records":[{"misconception_id":"equals-sign-means-answer-next","depth":"direct_empirical","sources":["research-stephens-equal-sign-2013"],"publication_status":"usable_with_scope_note"},{"misconception_id":"fraction-larger-denominator-means-larger","depth":"direct_empirical_plus_synthesis","sources":["research-meert-fraction-comparison-2010","us-ies-fractions-2010"],"publication_status":"usable_with_scope_note"},{"misconception_id":"pv-digit-value-is-digit-name","depth":"direct_empirical_broad_construct_or_mechanism","sources":["research-fuson-place-value-1997","research-lafay-place-value-2023"],"publication_status":"usable_if_worded_as_possible_place_value_reasoning"},{"misconception_id":"pv-zero-has-no-structural-role","depth":"direct_empirical_language_mediated","sources":["research-hewitt-alajmi-transcoding-2023"],