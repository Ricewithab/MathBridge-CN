{
  "version": "0.1.0",
  "purpose": "Canonical registry for joining MathBridge curriculum, teaching and diagnostic data without duplicating content. Aliases exist only to resolve older shorthand IDs; new records should use canonical IDs directly.",
  "canonical_sources": {
    "concepts": "database/concept_taxonomy.json",
    "curriculum_map": "database/concept_curriculum_map.json",
    "number_progression": "database/progression/core_number_cn_uk_us.json",
    "operations_progression": "database/progression/operations_cn_uk_us.json",
    "representations": "database/teaching/representation_catalog.json",
    "teaching_moves": "database/teaching/teaching_moves_catalog.json",
    "misconceptions": "database/diagnostics/misconception_catalog.json",
    "diagnostic_questions": "database/diagnostics/diagnostic_question_catalog.json",
    "diagnostic_rules": "database/diagnostics/diagnostic_interpretation_rules.json",
    "sources": "database/sources.json",
    "source_metadata": "database/source_metadata.json"
  },
  "canonical_representation_ids": [
    "number-bonds-part-whole",
    "ten-frame",
    "base-ten-place-value-models",
    "number-line",
    "arrays",
    "bar-model-tape-diagram",
    "area-model",
    "partial-products-expanded-methods",
    "standard-written-algorithm"
  ],
  "representation_aliases": {
    "part-whole-number-bond": ["number-bonds-part-whole"],
    "base-ten-place-value-model": ["base-ten-place-value-models"],
    "bar-model": ["bar-model-tape-diagram"],
    "array": ["arrays"],
    "partial-products": ["partial-products-expanded-methods"],
    "visual-fraction-model": ["area-model", "bar-model-tape-diagram", "number-line"]
  },
  "canonical_teaching_move_ids": [
    "connect-representations",
    "fade-support",
    "compare-methods",
    "variation-one-feature",
    "reason-from-structure",
    "explain-why",
    "represent-before-symbolise",
    "use-precise-language-structures",
    "use-error-and-misconception",
    "move-from-context-to-model"
  ],
  "diagnostic_action_routing": {
    "ask-for-representation": ["represent-before-symbolise"],
    "compare-examples": ["variation-one-feature", "compare-methods"],
    "probe-why": ["explain-why"],
    "vary-one-feature": ["variation-one-feature"],
    "ask-what-is-known-unknown": ["move-from-context-to-model"],
    "represent-before-calculate": ["represent-before-symbolise", "reason-from-structure"],
    "compare-problem-structures": ["compare-methods", "move-from-context-to-model"],
    "connect-inverse": ["reason-from-structure", "connect-representations"],
    "ask-for-second-method": ["compare-methods"],
    "probe-structure": ["reason-from-structure"],
    "use-benchmark": ["reason-from-structure"],
    "compare-same-whole": ["compare-methods", "connect-representations"],
    "probe-definition": ["explain-why"],
    "locate-before-calculate": ["represent-before-symbolise", "reason-from-structure"],
    "compare-same-point": ["connect-representations"],
    "ask-for-justification": ["explain-why"],
    "align-place-values": ["connect-representations", "reason-from-structure"],
    "connect-representation-to-algorithm": ["connect-representations"],
    "estimate-before-calculate": ["reason-from-structure"],
    "explain-each-line": ["explain-why", "connect-representations"],
    "compare-methods": ["compare-methods"]
  },
  "routing_note": "Diagnostic-action routing maps an older granular action to one or more canonical teaching moves for UI/recommendation assembly. It does not claim the terms are exact pedagogical synonyms.",
  "integrity_rules": [
    "All new concept profiles must use concept IDs from concept_taxonomy.json.",
    "All new representation references must use canonical_representation_ids.",
    "All new teaching-move references must use canonical_teaching_move_ids.",
    "Legacy aliases may be resolved at read time but should not be written into new intelligence records.",
    "A missing reference is an integrity error and must not be silently ignored."
  ]
}